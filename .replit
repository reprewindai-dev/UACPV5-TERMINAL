modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 80

[userenv]

[userenv.shared]
CAPPO_BACKEND_URL = "https://cappo.veklom.com"
GNOMLEDGER_URL = "https://gnomledger.veklom.com"
VEKLOM_BACKEND_URL = "https://api.veklom.com"
LOCKERPHYCER_URL = "https://lockerphycer.veklom.com"
